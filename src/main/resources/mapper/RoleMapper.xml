<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neonnexus.vcdm.mapper.RoleMapper">

    <resultMap id="RoleResultMap" type="com.neonnexus.vcdm.entity.po.auth.Role">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据用户ID查询角色列表 -->
    <select id="findByUserId" resultMap="RoleResultMap">
        SELECT r.id, r.name, r.code, r.description, r.status, r.create_time, r.update_time
        FROM `role` r
        INNER JOIN `user_role` ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
        AND r.status = 1
    </select>

    <!-- 根据角色代码查询 -->
    <select id="findByCode" resultMap="RoleResultMap">
        SELECT id, name, code, description, status, create_time, update_time
        FROM `role`
        WHERE code = #{code}
        AND status = 1
    </select>

    <!-- 根据ID查询 -->
    <select id="findById" resultMap="RoleResultMap">
        SELECT id, name, code, description, status, create_time, update_time
        FROM `role`
        WHERE id = #{id}
        AND status = 1
    </select>

</mapper>

